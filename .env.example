# ======================================================
# MPLADS Monitor — Environment Configuration
# ======================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Database ---
DATABASE_URL=postgresql://mplads_user:mplads_pass@localhost:5432/mplads_db
POSTGRES_DB=mplads_db
POSTGRES_USER=mplads_user
POSTGRES_PASSWORD=mplads_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- MPLADS Portal ---
MPLADS_API_BASE=https://mplads.mospi.gov.in
MPLADS_REQUEST_TIMEOUT=120
MPLADS_MAX_RETRIES=3

# --- ML Model ---
MODEL_VERSION=1.0.0
RULES_VERSION=1.0.0
ISOLATION_FOREST_CONTAMINATION=0.05
SIMILARITY_THRESHOLD=0.75

# --- Risk Score Weights ---
WEIGHT_FINANCIAL=0.25
WEIGHT_DELAY=0.20
WEIGHT_EXPENDITURE=0.20
WEIGHT_DUPLICATE=0.15
WEIGHT_PEER=0.10
WEIGHT_ML=0.10

# --- Risk Band Thresholds ---
LOW_MAX=24
MODERATE_MAX=49
HIGH_MAX=74
# CRITICAL = 75-100

# --- Data Paths ---
DATA_RAW_DIR=../data/raw
DATA_PROCESSED_DIR=../data/processed
MODEL_DIR=../ml/models

# --- Security ---
SECRET_KEY=change_this_to_a_secure_random_string_in_production
